# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# HTTP
HTTP_ADDR=:8080
GIN_MODE=debug
LOG_LEVEL=debug
LOG_FORMAT=text
# Comma separated. Use the exact origin the React dev server runs on.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Postgres
# Local (docker compose up -d):
DATABASE_URL=postgres://architect:architect@localhost:5432/architect?sslmode=disable
# RDS example:
# DATABASE_URL=postgres://USER:PASSWORD@your-db.abcdefg.ap-south-1.rds.amazonaws.com:5432/architect?sslmode=require
DB_MAX_CONNS=10
DB_MIN_CONNS=1
RUN_MIGRATIONS=true

# Auth
# Generate: openssl rand -base64 48   (PowerShell: [Convert]::ToBase64String((1..48|%{Get-Random -Max 256})))
JWT_SECRET=change-me-to-at-least-32-random-characters
JWT_ISSUER=ai-aws-architect
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# LLM: "bedrock" for the real thing, "stub" to develop the whole flow with no
# AWS calls and no credit burn. The stub returns a deterministic proposal so
# versioning / diff / revert can be exercised end to end.
LLM_PROVIDER=stub

# Bedrock
AWS_REGION=ap-south-1
# Verify the exact ID that is enabled in YOUR account and region:
#   aws bedrock list-inference-profiles --region ap-south-1
#   aws bedrock list-foundation-models --region ap-south-1 --by-provider anthropic
# Cross-region inference profiles are prefixed with the geo (us. / eu. / apac.).
BEDROCK_MODEL_ID=apac.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MAX_TOKENS=4096
BEDROCK_TEMPERATURE=0.2
# Optional: leave empty to use the default credential chain (env vars, SSO,
# ~/.aws/credentials, or the instance/task role once deployed).
AWS_PROFILE=

# Agent
AGENT_MAX_HISTORY_MESSAGES=20
AGENT_TIMEOUT=90s

# ---------------------------------------------------------------------------
# Cross-account connection
#
# This is the identity on OUR side that assumes customer roles. It is named in
# every trust policy we generate, so it is the most security-critical principal
# in the system: compromising it reaches every connected account.
# Leave AWS_SERVICE_ACCOUNT_ID empty to disable the connect flow entirely -
# proposals still work without it.
# ---------------------------------------------------------------------------
AWS_SERVICE_ACCOUNT_ID=
AWS_SERVICE_ROLE_NAME=ai-aws-architect-provisioner

# Publicly readable URL of deploy/cloudformation/connect-role.yaml. The
# customer's browser fetches it, so it cannot be a private object.
AWS_CONNECT_TEMPLATE_URL=https://your-bucket.s3.amazonaws.com/connect-role.yaml

# Region customer resources are provisioned into. Stored on the connection, NOT
# taken from model output.
AWS_DEFAULT_PROVISION_REGION=ap-south-1

# How long a connection health check stays trusted before a page load triggers
# a fresh STS call.
AWS_CONNECTION_CHECK_TTL=60s

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
# "stub" simulates plan/apply/destroy with no Terraform and no AWS calls, so
# the whole lifecycle can be exercised for free.
RUNNER_PROVIDER=stub

# Terraform runner (only read when RUNNER_PROVIDER=terraform)
TERRAFORM_BINARY=terraform
# Must persist between plan and apply: apply runs the SAVED plan file.
TF_WORK_ROOT=/var/tmp/ai-aws-architect
# Holds terraform state, one key per chat. Create it in the SERVICE account.
TF_STATE_BUCKET=
TF_STATE_REGION=ap-south-1
# Each workspace holds a full copy of the AWS provider (~800MB without a plugin
# cache). Unreferenced ones are swept after this long.
TF_WORKSPACE_TTL=2h

# Applied resources are destroyed automatically after this long. Set to 0 to
# disable - but then nothing cleans up after a demo.
DEPLOY_TEARDOWN_AFTER=45m

# Bounds a single terraform run. On expiry the outcome is UNKNOWN, not failed:
# the run may have partially taken effect.
DEPLOY_MAX_RUN_TIME=20m

WORKER_ENABLED=true
WORKER_POLL_INTERVAL=2s

# How long a silent running job waits before being declared abandoned. MUST be
# greater than DEPLOY_MAX_RUN_TIME, or a healthy slow run gets reclaimed.
JOB_STALE_AFTER=25m
