# Normalise line endings so a native-Windows checkout does not create diff noise.
* text=auto eol=lf

*.go        text eol=lf
*.sql       text eol=lf
*.json      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.md        text eol=lf
*.sh        text eol=lf
*.ps1       text eol=crlf
Makefile    text eol=lf

*.png binary
*.jpg binary
*.ico binary
